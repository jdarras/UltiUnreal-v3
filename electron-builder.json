{
  "appId": "com.juliendarras.ultiunreal",
  "productName": "UltiUnreal",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "extraMetadata": {
    "main": "main-dist/main.cjs"
  },
  "files": [
    "package.json",
    "main-dist/**",
    "dist/**",
    "app/**",
    "!tools/**",
    "!data/**"
  ],
  "extraResources": [
    {
      "from": "tools/ffmpeg/win/ffmpeg.exe",
      "to": "ffmpeg/ffmpeg.exe"
    },
    {
      "from": "tools/ffmpeg/win/ffprobe.exe",
      "to": "ffmpeg/ffprobe.exe"
    }
  ],
  "win": {
    "artifactName": "UltiUnreal ${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "UltiUnreal Setup ${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "include": "installer.nsh",
    "displayLanguageSelector": true,
    "installerLanguages": [
      "en_US",
      "fr_FR"
    ],
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true
  }
}
